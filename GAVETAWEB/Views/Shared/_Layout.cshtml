<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAVETAWEB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GAVETAWEB.styles.css" asp-append-version="true" />
    <style>
        /* Corrige o footer padrão do template, que vem com position: absolute
                   e sobrepõe o conteúdo em páginas mais altas que a tela */
        footer.footer {
            position: static !important;
        }
    </style>
</head>
<body>
    @if (ViewData["EsconderNavbar"] == null)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark border-bottom shadow mb-3">

                <div class="container-fluid d-flex align-items-center">

                    
                    <a class="navbar-brand me-4"
                       asp-controller="Home"
                       asp-action="Index">
                        GAVETA DA SORTE
                    </a>


                    
                    <div class="navbar-nav d-flex flex-row gap-3">

                        <a class="nav-link"
                           asp-controller="Usuario"
                           asp-action="Comunidade">
                            Comunidade
                        </a>
                        <a class="nav-link"
                           asp-controller="Usuario"
                           asp-action="EditarCadastro">
                            Editar Cadastro
                        </a>


                        <a class="nav-link"
                           asp-controller="Grupo"
                           asp-action="Cadastro">
                            Criar Grupo
                        </a>


                        <a class="nav-link"
                           asp-controller="Grupo"
                           asp-action="GrupoTelaInicial">
                            Meus Grupos
                        </a>


                        <a class="nav-link"
                           asp-controller="Usuario"
                           asp-action="Logout">
                            Sair
                        </a>

                    </div>

                </div>

            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GAVETAWEB - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>