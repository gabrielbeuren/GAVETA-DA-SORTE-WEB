@model GAVETAWEB.Models.Usuario

<form asp-action="Cadastro" method="post">

	<div class="mb-3">
		<label asp-for="Nome"> </label>
		<input asp-for="Nome" class="form-control" requiered />
	</div>

	<div class="mb-3">
		<label asp-for="CPF"></label>
		<input asp-for="CPF" class="form-control" maxlength="11" minlength="11" required />
	</div>

	<div>
		<label asp-for="Sexo"></label>

		<select asp-for="Sexo" class="form-control" required>
			<option value="">Selecione</option>
			<option value="Masculino">Masculino</option>
			<option value="Feminino">Feminino</option>
			<option value="Outro">Outro</option>
		</select>
	</div>

	<div>
		<label asp-for="DataNascimento"></label>

		<input asp-for="DataNascimento"
			   class="form-control"
			   type="date"
			   required />
	</div>
	 

	<div class="mb-3">
		<label asp-for="Email"> </label>
		<input asp-for="Email" class="form-control" type="email" required />
	</div>

	<div class="mb-3">
		<label asp-for="Senha"> </label>
		<input asp-for="Senha" class="form-control" type="password" minlength="6" required />
	</div>

	<div class="mb-3">
		<label>Confirmar Senha</label>
		<input type="password" id="ConfirmarSenha" class="form-control" required />
	</div>

	<button type="submit">Cadastrar</button>

	<a asp-controller="Usuario" asp-action="Login">
		Voltar para tela de login
	</a>
	<script>
		document.querySelector("form").addEventListener("submit", function (e) {

			const senha = document.getElementById("Senha").value;
			const confirmar = document.getElementById("ConfirmarSenha").value;

			if (senha !== confirmar) {
				e.preventDefault();
				alert("As senhas não conferem.");
			}

		});
	</script>
</form>
