<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h3>Adicionar Saldo</h3>
        </div>

        <div class="card-body">

            <form asp-controller="Grupo" asp-action="AdicionarSaldo" method="post">

                <div class="mb-3">

                    <label>Valor</label>

                    <input type="number"
                           step="0.01"
                           min="1.00"
                           name="valor"
                           class="form-control" />

                </div>

                <button class="btn btn-success">
                    Adicionar
                </button>

            </form>

        </div>

    </div>

</div>
