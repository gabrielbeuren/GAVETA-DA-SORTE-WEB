
<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h3>Realizar Depósito</h3>
        </div>

        <div class="card-body">

            <form asp-action="Deposito" method="post">

                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Erro"]
                    </div>
                }

                <input type="hidden" name="GrupoId" value="@ViewBag.GrupoId" />

                <div class="mb-3">
                    <label class="form-label">
                        Valor do Depósito
                    </label>

                    <input name="Valor"
                           type="number"
                           step="0.01"
                           min="1.00"
                           class="form-control"
                           required />
                </div>


                <button type="submit" class="btn btn-success">
                    Depositar
                </button>

                <a asp-action="Detalhes"
                   asp-route-id="@ViewBag.GrupoId"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>

    </div>

</div>
