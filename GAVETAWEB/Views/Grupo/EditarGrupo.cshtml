@model GAVETAWEB.Models.Grupo

<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h3>Editar Grupo</h3>
        </div>

        <div class="card-body">

            <form asp-action="EditarGrupo" method="post">

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome do Grupo
                    </label>

                    <input asp-for="Nome" class="form-control" />
                </div>


                <div class="mb-3">

                    <label asp-for="Descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="5"></textarea>

                </div>


                <button type="submit" class="btn btn-success">
                    Salvar
                </button>

                <a asp-action="Detalhes"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>