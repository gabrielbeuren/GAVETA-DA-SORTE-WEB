@model GAVETAWEB.Models.Grupo

<div class="auth-container">
	<h2 class="text-center mb-4">Criar Grupo</h2>

	<form asp-action="Cadastro" method="post">
		
		<div class="mb-3">
			<label asp-for="Nome" class="form-label">Nome do Grupo</label>
			<input asp-for="Nome" class="form-control" required />
		</div>


		<div class="mb-3">
			<label asp-for="Descricao" class="form-label">Descricao</label>
			<textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
		</div>

		<button type="submit" class="btn btn-primary mb-3">CRIAR GRUPO</button>

		</form>

	

</div>
